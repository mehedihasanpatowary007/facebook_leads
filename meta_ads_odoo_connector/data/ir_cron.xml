<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_meta_ads_sync" model="ir.cron">
        <field name="name">Meta Ads: Sync Active Connections</field>
        <field name="model_id" ref="model_meta_ads_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_active_configs()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">False</field>
    </record>

    <record id="ir_cron_meta_capi_send_events" model="ir.cron">
        <field name="name">Meta Ads: Send Conversion Events</field>
        <field name="model_id" ref="model_meta_conversion_event"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_ready_events()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">False</field>
    </record>
</odoo>
