<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_ad_list" model="ir.ui.view">
        <field name="name">meta.ad.list</field>
        <field name="model">meta.ad</field>
        <field name="arch" type="xml">
            <list string="Meta Ads">
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="adset_id"/>
                <field name="creative_id"/>
                <field name="status"/>
                <field name="effective_status"/>
                <field name="conversion_domain"/>
                <field name="last_sync_at"/>
            </list>
        </field>
    </record>

    <record id="view_meta_ad_form" model="ir.ui.view">
        <field name="name">meta.ad.form</field>
        <field name="model">meta.ad</field>
        <field name="arch" type="xml">
            <form string="Meta Ad">
                <sheet>
                    <group>
                        <group string="Ad">
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="config_id"/>
                            <field name="ad_account_id"/>
                            <field name="campaign_id"/>
                            <field name="adset_id"/>
                            <field name="creative_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Meta IDs">
                            <field name="meta_ad_id"/>
                            <field name="meta_campaign_id"/>
                            <field name="meta_adset_id"/>
                            <field name="meta_creative_id"/>
                            <field name="status"/>
                            <field name="effective_status"/>
                            <field name="last_sync_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Tracking">
                        <field name="preview_shareable_link"/>
                        <field name="conversion_domain"/>
                    </group>
                    <notebook>
                        <page string="Tracking Specs">
                            <field name="tracking_specs_json" nolabel="1"/>
                        </page>
                        <page string="Raw Payload" groups="meta_ads_odoo_connector.group_meta_ads_technical">
                            <field name="raw_payload" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_meta_ad_search" model="ir.ui.view">
        <field name="name">meta.ad.search</field>
        <field name="model">meta.ad</field>
        <field name="arch" type="xml">
            <search string="Search Ads">
                <field name="name"/>
                <field name="meta_ad_id"/>
                <field name="campaign_id"/>
                <field name="adset_id"/>
                <field name="creative_id"/>
                <field name="status"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Campaign" name="group_campaign" context="{'group_by': 'campaign_id'}"/>
                <filter string="Ad Set" name="group_adset" context="{'group_by': 'adset_id'}"/>
                <filter string="Creative" name="group_creative" context="{'group_by': 'creative_id'}"/>
                <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_meta_ad" model="ir.actions.act_window">
        <field name="name">Ads</field>
        <field name="res_model">meta.ad</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_meta_ad_search"/>
    </record>
</odoo>
