<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_wub_ipcalling" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.wub.ipcalling</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_ip_call"
                        string="IP Call"
                        type="object"
                        class="oe_highlight"
                        icon="fa-phone"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ip_call_history"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-phone">
                    <field name="ip_call_history_count" widget="statinfo" string="IP Calls"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
