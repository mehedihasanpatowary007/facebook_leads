<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_wub_hangup" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.wub.hangup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="zencore_wub_ipcalling.res_config_settings_view_form_inherit_wub_ipcalling"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wub_ipcalling_endpoint_path']/.." position="after">
                <div class="row mt8">
                    <label for="wub_ipcalling_hangup_endpoint_path" class="col-lg-3 o_light_label"/>
                    <field name="wub_ipcalling_hangup_endpoint_path" class="col-lg-9" placeholder="/wub/api/call_hangup.php"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
