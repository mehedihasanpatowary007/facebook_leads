<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_meta_lead_ads" model="ir.module.category">
        <field name="name">Meta Lead Ads</field>
        <field name="description">Real-time Meta Lead Ads webhook integration</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_meta_lead_ads" model="res.groups.privilege">
        <field name="name">Meta Lead Ads</field>
        <field name="category_id" ref="module_category_meta_lead_ads"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_meta_lead_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_meta_lead_ads"/>
        <field name="comment">Can read Meta Lead Ads webhook records and CRM attribution.</field>
    </record>

    <record id="group_meta_lead_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_meta_lead_ads"/>
        <field name="implied_ids" eval="[(4, ref('group_meta_lead_user'))]"/>
        <field name="comment">Can configure mappings, process queue records, and manage imported leads.</field>
    </record>

    <record id="group_meta_lead_technical" model="res.groups">
        <field name="name">Technical Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_meta_lead_ads"/>
        <field name="implied_ids" eval="[(4, ref('group_meta_lead_manager'))]"/>
        <field name="comment">Can configure tokens, app secrets, webhook validation, and technical logs.</field>
    </record>

    <!-- Give normal Odoo Settings administrators access to this technical integration menu after installation. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_meta_lead_technical'))]"/>
    </record>

    <record id="rule_meta_lead_connection_company" model="ir.rule">
        <field name="name">Meta Lead Connection: multi-company</field>
        <field name="model_id" ref="model_meta_lead_connection"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_meta_lead_user'))]"/>
    </record>

    <record id="rule_meta_lead_form_mapping_company" model="ir.rule">
        <field name="name">Meta Lead Form Mapping: multi-company</field>
        <field name="model_id" ref="model_meta_lead_form_mapping"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_meta_lead_user'))]"/>
    </record>

    <record id="rule_meta_lead_webhook_event_company" model="ir.rule">
        <field name="name">Meta Webhook Event: multi-company</field>
        <field name="model_id" ref="model_meta_lead_webhook_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_meta_lead_user'))]"/>
    </record>

    <record id="rule_meta_lead_queue_company" model="ir.rule">
        <field name="name">Meta Lead Queue: multi-company</field>
        <field name="model_id" ref="model_meta_lead_queue"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_meta_lead_user'))]"/>
    </record>
</odoo>
