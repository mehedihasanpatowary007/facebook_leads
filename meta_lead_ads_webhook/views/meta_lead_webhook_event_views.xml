<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_lead_webhook_event_list" model="ir.ui.view">
        <field name="name">meta.lead.webhook.event.list</field>
        <field name="model">meta.lead.webhook.event</field>
        <field name="arch" type="xml">
            <list string="Webhook Events" decoration-danger="state == 'failed'" decoration-success="state == 'queued'">
                <field name="received_at"/>
                <field name="state"/>
                <field name="connection_id"/>
                <field name="object_type"/>
                <field name="meta_page_id"/>
                <field name="signature_valid"/>
                <field name="queue_count"/>
            </list>
        </field>
    </record>

    <record id="view_meta_lead_webhook_event_form" model="ir.ui.view">
        <field name="name">meta.lead.webhook.event.form</field>
        <field name="model">meta.lead.webhook.event</field>
        <field name="arch" type="xml">
            <form string="Webhook Event" create="false">
                <header>
                    <button name="action_open_queue" type="object" string="Open Queued Leads" class="btn-primary" invisible="queue_count == 0"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="received_at" readonly="1"/>
                            <field name="connection_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="object_type" readonly="1"/>
                            <field name="meta_page_id" readonly="1"/>
                            <field name="signature_valid" readonly="1"/>
                            <field name="queue_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Raw Body" groups="meta_lead_ads_webhook.group_meta_lead_technical">
                            <field name="raw_body" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Signature" groups="meta_lead_ads_webhook.group_meta_lead_technical">
                            <group>
                                <field name="signature_header" readonly="1"/>
                            </group>
                        </page>
                        <page string="Error">
                            <field name="error_message" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Queued Leads">
                            <field name="queue_ids" readonly="1">
                                <list>
                                    <field name="leadgen_id"/>
                                    <field name="state"/>
                                    <field name="form_id"/>
                                    <field name="crm_lead_id"/>
                                    <field name="last_error"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_meta_lead_webhook_event_search" model="ir.ui.view">
        <field name="name">meta.lead.webhook.event.search</field>
        <field name="model">meta.lead.webhook.event</field>
        <field name="arch" type="xml">
            <search string="Search Webhook Events">
                <field name="meta_page_id"/>
                <field name="connection_id"/>
                <filter string="Queued" name="queued" domain="[('state', '=', 'queued')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Today" name="today" domain="[('received_at', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Connection" name="group_connection" context="{'group_by': 'connection_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_meta_lead_webhook_event" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">meta.lead.webhook.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
