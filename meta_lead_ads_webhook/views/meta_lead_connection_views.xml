<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_lead_connection_list" model="ir.ui.view">
        <field name="name">meta.lead.connection.list</field>
        <field name="model">meta.lead.connection</field>
        <field name="arch" type="xml">
            <list string="Meta Lead Connections">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="page_id"/>
                <field name="api_version"/>
                <field name="auto_create_crm_lead"/>
                <field name="enforce_signature"/>
                <field name="last_test_status"/>
                <field name="last_test_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_meta_lead_connection_form" model="ir.ui.view">
        <field name="name">meta.lead.connection.form</field>
        <field name="model">meta.lead.connection</field>
        <field name="arch" type="xml">
            <form string="Meta Lead Connection">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                    <button name="action_process_pending_queue" type="object" string="Process Pending Leads" class="btn-secondary"/>
                    <button name="action_open_webhook_events" type="object" string="Webhook Events"/>
                    <button name="action_open_lead_queue" type="object" string="Lead Queue"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="api_version"/>
                            <field name="app_id"/>
                        </group>
                        <group>
                            <field name="page_id"/>
                            <field name="webhook_url" readonly="1"/>
                            <field name="webhook_verify_token" password="1"/>
                            <field name="enforce_signature"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tokens &amp; Secrets" groups="meta_lead_ads_webhook.group_meta_lead_technical">
                            <group>
                                <field name="page_access_token" password="1"/>
                                <field name="app_secret" password="1"/>
                            </group>
                            <p class="text-muted">
                                Store a Page access token with lead retrieval permissions. Keep the app secret private and never share it in logs or screenshots.
                            </p>
                        </page>
                        <page string="CRM Defaults">
                            <group>
                                <group>
                                    <field name="auto_create_crm_lead"/>
                                    <field name="process_immediately"/>
                                    <field name="duplicate_strategy"/>
                                    <field name="default_team_id"/>
                                    <field name="default_user_id"/>
                                </group>
                                <group>
                                    <field name="default_source_id"/>
                                    <field name="default_medium_id"/>
                                    <field name="default_tag_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        <page string="Retry Policy">
                            <group>
                                <field name="max_retry_count"/>
                                <field name="retry_delay_minutes"/>
                            </group>
                        </page>
                        <page string="Last Test">
                            <group>
                                <field name="last_test_status" readonly="1"/>
                                <field name="last_test_at" readonly="1"/>
                                <field name="last_test_message" readonly="1" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_meta_lead_connection_search" model="ir.ui.view">
        <field name="name">meta.lead.connection.search</field>
        <field name="model">meta.lead.connection</field>
        <field name="arch" type="xml">
            <search string="Search Meta Lead Connections">
                <field name="name"/>
                <field name="page_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                <filter string="Test Status" name="group_test_status" context="{'group_by': 'last_test_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_meta_lead_connection" model="ir.actions.act_window">
        <field name="name">Meta Connections</field>
        <field name="res_model">meta.lead.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your Meta Lead Ads webhook connection.</p>
            <p>Configure Page ID, Page Access Token, App Secret, and Webhook Verify Token.</p>
        </field>
    </record>
</odoo>
