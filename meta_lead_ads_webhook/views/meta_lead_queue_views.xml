<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_lead_queue_list" model="ir.ui.view">
        <field name="name">meta.lead.queue.list</field>
        <field name="model">meta.lead.queue</field>
        <field name="arch" type="xml">
            <list string="Meta Lead Queue" decoration-success="state == 'done'" decoration-warning="state == 'retry'" decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="leadgen_id"/>
                <field name="state"/>
                <field name="connection_id"/>
                <field name="form_id"/>
                <field name="campaign_id"/>
                <field name="ad_id"/>
                <field name="crm_lead_id"/>
                <field name="retry_count"/>
                <field name="next_retry_at"/>
                <button name="action_process_now" type="object" string="Process" class="btn-link" invisible="state in ['done', 'duplicate', 'ignored']"/>
                <button name="action_retry" type="object" string="Retry" class="btn-link" invisible="state not in ['failed', 'retry']"/>
            </list>
        </field>
    </record>

    <record id="view_meta_lead_queue_form" model="ir.ui.view">
        <field name="name">meta.lead.queue.form</field>
        <field name="model">meta.lead.queue</field>
        <field name="arch" type="xml">
            <form string="Meta Lead Queue" create="false">
                <header>
                    <button name="action_process_now" type="object" string="Process Now" class="btn-primary" invisible="state in ['done', 'duplicate', 'ignored']"/>
                    <button name="action_retry" type="object" string="Retry" class="btn-secondary" invisible="state not in ['failed', 'retry']"/>
                    <button name="action_open_crm_lead" type="object" string="Open CRM Lead" invisible="not crm_lead_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processing,done,retry,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="leadgen_id" readonly="1"/>
                            <field name="connection_id" readonly="1"/>
                            <field name="webhook_event_id" readonly="1"/>
                            <field name="crm_lead_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="form_id" readonly="1"/>
                            <field name="page_id" readonly="1"/>
                            <field name="campaign_id" readonly="1"/>
                            <field name="adset_id" readonly="1"/>
                            <field name="ad_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Retry Information">
                        <field name="retry_count" readonly="1"/>
                        <field name="next_retry_at" readonly="1"/>
                        <field name="processed_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Webhook Payload">
                            <field name="payload_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Fetched Lead Data">
                            <field name="lead_data_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Field Data">
                            <field name="field_data_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Error">
                            <field name="last_error" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_meta_lead_queue_search" model="ir.ui.view">
        <field name="name">meta.lead.queue.search</field>
        <field name="model">meta.lead.queue</field>
        <field name="arch" type="xml">
            <search string="Search Meta Lead Queue">
                <field name="leadgen_id"/>
                <field name="form_id"/>
                <field name="page_id"/>
                <field name="connection_id"/>
                <field name="crm_lead_id"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Retry" name="retry" domain="[('state', '=', 'retry')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Today" name="today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Connection" name="group_connection" context="{'group_by': 'connection_id'}"/>
                <filter string="Form" name="group_form" context="{'group_by': 'form_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_meta_lead_queue" model="ir.actions.act_window">
        <field name="name">Lead Queue</field>
        <field name="res_model">meta.lead.queue</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
