<odoo>
    <record id="view_facebook_lead_config_list" model="ir.ui.view">
        <field name="name">facebook.lead.config.list</field><field name="model">facebook.lead.config</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="page_name"/><field name="page_id"/><field name="default_team_id"/><field name="auto_sync"/><field name="last_sync_at"/><field name="active"/></list></field>
    </record>
    <record id="view_facebook_lead_config_form" model="ir.ui.view">
        <field name="name">facebook.lead.config.form</field><field name="model">facebook.lead.config</field>
        <field name="arch" type="xml"><form string="Facebook Lead Integration"><header><button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/></header><sheet>
            <widget name="web_ribbon" title="Archived" invisible="active"/><group><group><field name="name"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/><field name="page_name"/><field name="page_id"/></group><group><field name="app_id"/><field name="api_version"/><field name="webhook_url" readonly="1"/><field name="verify_token" password="1"/></group></group>
            <notebook><page string="Credentials"><group><field name="page_access_token" password="1"/><field name="app_secret" password="1"/><field name="validate_signature"/></group></page>
            <page string="CRM Defaults"><group><field name="default_team_id"/><field name="default_user_id"/><field name="default_source_id"/><field name="default_medium_id"/></group></page>
            <page string="Backup Sync"><group><field name="auto_sync"/><field name="sync_interval" invisible="not auto_sync"/><field name="last_sync_at" readonly="1"/></group></page></notebook>
        </sheet></form></field>
    </record>
    <record id="action_facebook_lead_config" model="ir.actions.act_window"><field name="name">Facebook Lead Integration</field><field name="res_model">facebook.lead.config</field><field name="view_mode">list,form</field></record>
</odoo>
