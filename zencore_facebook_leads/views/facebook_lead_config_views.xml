<odoo>
    <record id="view_facebook_lead_config_list" model="ir.ui.view">
        <field name="name">facebook.lead.config.list</field><field name="model">facebook.lead.config</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="page_name"/><field name="page_id"/><field name="webhook_subscribed"/><field name="form_count"/><field name="default_team_id"/><field name="auto_sync"/><field name="last_sync_at"/><field name="active"/></list></field>
    </record>
    <record id="view_facebook_lead_config_form" model="ir.ui.view">
        <field name="name">facebook.lead.config.form</field><field name="model">facebook.lead.config</field>
        <field name="arch" type="xml"><form string="Facebook Page"><header><button name="action_import_forms" type="object" string="Fetch Lead Forms" class="btn-primary"/><button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary"/><button name="action_subscribe_webhook" type="object" string="Subscribe Webhook" class="btn-secondary" invisible="webhook_subscribed"/><button name="action_sync_backlog_now" type="object" string="Fetch All Previous Leads" class="btn-secondary"/></header><sheet>
            <widget name="web_ribbon" title="Archived" invisible="active"/><div class="alert alert-primary" role="alert"><strong>Step 3 of 3:</strong> Click <strong>Fetch Lead Forms</strong>. Open a form, confirm its CRM Field Mapping, then click <strong>Fetch Leads</strong>.</div><div class="oe_button_box" name="button_box"><button name="action_open_forms" type="object" class="oe_stat_button" icon="fa-list-alt"><field name="form_count" widget="statinfo" string="Lead Forms"/></button></div><group><group string="Facebook Page"><field name="name"/><field name="active"/><field name="account_id"/><field name="company_id" groups="base.group_multi_company"/><field name="page_name"/><field name="page_id"/></group><group string="Connection"><field name="app_id"/><field name="api_version"/><field name="webhook_subscribed"/><field name="webhook_url" readonly="1"/><field name="verify_token" password="1"/></group></group>
            <notebook><page string="Credentials"><group><field name="page_access_token" password="1"/><field name="app_secret" password="1"/><field name="validate_signature"/></group></page>
            <page string="CRM Defaults"><group><field name="default_team_id"/><field name="default_user_id"/><field name="default_source_id"/><field name="default_medium_id"/></group></page>
            <page string="Backup Sync"><group><group><field name="auto_sync"/><field name="sync_interval" invisible="not auto_sync"/><field name="last_sync_at" readonly="1"/><field name="full_sync_requested" readonly="1"/></group><group><field name="processing_batch_size"/><field name="max_retry_count"/><field name="retry_delay_minutes"/><field name="log_retention_days"/></group></group></page>
            <page string="Monitoring"><group><group><field name="last_webhook_at"/><field name="last_success_at"/><field name="last_error_at"/></group><group><field name="consecutive_failures"/><field name="webhook_subscription_error" readonly="1"/><field name="last_error_message" nolabel="1"/></group></group></page></notebook>
        </sheet><chatter/></form></field>
    </record>
    <record id="action_facebook_lead_config" model="ir.actions.act_window"><field name="name">Facebook Pages</field><field name="res_model">facebook.lead.config</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Fetch Pages from a Facebook App Credential</p><p>Open Facebook App Credentials and click Fetch Facebook Pages.</p></field></record>
</odoo>
