<odoo>
    <record id="view_facebook_lead_account_list" model="ir.ui.view">
        <field name="name">facebook.lead.account.list</field>
        <field name="model">facebook.lead.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="app_id"/>
                <field name="connected" widget="boolean_toggle"/>
                <field name="page_count"/>
                <field name="token_expires_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_facebook_lead_account_form" model="ir.ui.view">
        <field name="name">facebook.lead.account.form</field>
        <field name="model">facebook.lead.account</field>
        <field name="arch" type="xml">
            <form string="Facebook App Credential">
                <header>
                    <button name="action_connect_facebook" type="object" string="Generate Token" class="btn-primary" invisible="connected"/>
                    <button name="action_connect_facebook" type="object" string="Reconnect Facebook" class="btn-secondary" invisible="not connected"/>
                    <button name="action_import_pages" type="object" string="Fetch Facebook Pages" class="btn-primary" invisible="not connected"/>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary" invisible="not connected"/>
                    <button name="action_disconnect" type="object" string="Disconnect" class="btn-secondary" invisible="not connected" confirm="Remove the user access token from Odoo? Existing Page tokens and Meta permissions will remain active."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Connected" bg_color="text-bg-success" invisible="not connected"/>
                    <div class="alert alert-primary" role="alert" invisible="connected">
                        <strong>Step 1 of 3:</strong> Enter the Meta App ID and App Secret, copy the OAuth Redirect URL to the Meta App, then click <strong>Generate Token</strong>.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="not connected">
                        <strong>Step 2 of 3:</strong> Facebook is connected. Click <strong>Fetch Facebook Pages</strong>, then open a Page to fetch its Lead Forms.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_pages" type="object" class="oe_stat_button" icon="fa-flag">
                            <field name="page_count" widget="statinfo" string="Pages"/>
                        </button>
                    </div>
                    <group string="Facebook App Credentials">
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="app_id"/>
                            <field name="app_secret" password="1"/>
                            <field name="api_version"/>
                            <field name="verify_token" password="1" readonly="1"/>
                            <field name="oauth_redirect_uri" readonly="1" widget="CopyClipboardChar"/>
                        </group>
                    </group>
                    <group string="Authorization Status">
                        <field name="connected"/>
                        <field name="token_expires_at" readonly="1"/>
                        <field name="user_access_token" password="1" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert"><strong>Tip:</strong> Generate Token opens Facebook login. Select the Pages whose Lead Ads you want to import into Odoo.</div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_facebook_lead_account" model="ir.actions.act_window">
        <field name="name">Facebook App Credentials</field>
        <field name="res_model">facebook.lead.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create your Facebook App Credential</p><p>Enter the Meta App ID and App Secret, then use Generate Token to authorize Facebook Pages.</p></field>
    </record>
</odoo>
