<odoo>
    <record id="view_facebook_lead_log_list" model="ir.ui.view"><field name="name">facebook.lead.log.list</field><field name="model">facebook.lead.log</field><field name="arch" type="xml"><list create="0" delete="0"><field name="create_date"/><field name="facebook_lead_id"/><field name="facebook_form_name"/><field name="student_name"/><field name="status"/><field name="crm_lead_id"/><field name="retry_count"/><button name="action_retry" type="object" string="Retry" invisible="status not in ('pending', 'failed')"/></list></field></record>
