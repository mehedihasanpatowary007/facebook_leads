<odoo>
    <record id="view_crm_lead_form_facebook" model="ir.ui.view"><field name="name">crm.lead.form.facebook</field><field name="model">crm.lead</field><field name="inherit_id" ref="crm.crm_lead_view_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Facebook Information" invisible="not facebook_lead_id"><group><group><field name="facebook_lead_id"/><field name="facebook_page_id"/><field name="facebook_config_id"/></group><group><field name="facebook_form_id"/><field name="facebook_form_name"/><field name="facebook_ad_id"/><field name="facebook_campaign_id"/><field name="facebook_submission_date"/></group></group></page></xpath></field></record>
    <record id="view_crm_lead_search_facebook" model="ir.ui.view"><field name="name">crm.lead.search.facebook</field><field name="model">crm.lead</field><field name="inherit_id" ref="crm.view_crm_case_leads_filter"/><field name="arch" type="xml"><xpath expr="//search" position="inside"><filter name="facebook_leads" string="Facebook Leads" domain="[('facebook_lead_id', '!=', False)]"/><field name="facebook_form_name"/><field name="facebook_submission_date"/><filter name="group_facebook_form" string="Facebook Form" context="{'group_by': 'facebook_form_name'}"/></xpath></field></record>
</odoo>
