<odoo>
    <record id="rule_facebook_lead_account_company" model="ir.rule">
        <field name="name">Facebook connections: allowed companies</field>
        <field name="model_id" ref="model_facebook_lead_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="rule_facebook_lead_config_company" model="ir.rule">
        <field name="name">Facebook Pages: allowed companies</field>
        <field name="model_id" ref="model_facebook_lead_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_facebook_lead_form_company" model="ir.rule">
        <field name="name">Facebook forms: allowed companies</field>
        <field name="model_id" ref="model_facebook_lead_form"/>
        <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="rule_facebook_lead_mapping_company" model="ir.rule">
        <field name="name">Facebook mappings: allowed companies</field>
        <field name="model_id" ref="model_facebook_lead_mapping"/>
        <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="rule_facebook_campaign_mapping_company" model="ir.rule">
        <field name="name">Facebook campaign mappings: allowed companies</field>
        <field name="model_id" ref="model_facebook_campaign_mapping"/>
        <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="rule_facebook_lead_log_company" model="ir.rule">
        <field name="name">Facebook sync logs: allowed companies</field>
        <field name="model_id" ref="model_facebook_lead_log"/>
        <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
</odoo>
